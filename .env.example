# =========================================================================
# Environment Variables Example for vendor-ai Monorepo
# =========================================================================

# URL project Supabase
# Digunakan oleh: apps/web + apps/api
NEXT_PUBLIC_SUPABASE_URL=your_supabase_project_url

# Anon key untuk client-side
# Digunakan oleh: apps/web
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key

# Service role untuk operasi admin (SENSITIVE - DO NOT EXPOSE TO CLIENT)
# Digunakan oleh: apps/api
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key

# URL internal FastAPI service
# Digunakan oleh: apps/api
FASTAPI_URL=http://localhost:8000

# Token shared dengan AI Engineer
# Digunakan oleh: apps/api
SERVICE_TO_SERVICE_TOKEN=your_shared_service_token
